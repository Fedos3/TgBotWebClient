BOT_TOKEN=123456:ABC-YOUR-BOT-TOKEN
# Optional: comment out BOT_TOKEN and connect the first bot from the web UI.
# Optional multi-bot mode, up to 5 bots. All configured bots stay connected in
# background and keep saving incoming messages to SQLite. The frontend can then
# switch between them instantly without losing updates. Additional bots can also
# be connected later from the panel UI.
# BOT_TOKEN_1=123456:ABC-YOUR-FIRST-BOT-TOKEN
# BOT_LABEL_1=Support Bot
# BOT_TOKEN_2=123456:ABC-YOUR-SECOND-BOT-TOKEN
# BOT_LABEL_2=Sales Bot
# BOT_TOKEN_3=123456:ABC-YOUR-THIRD-BOT-TOKEN
# BOT_LABEL_3=Marketing Bot
# BOT_TOKEN_4=123456:ABC-YOUR-FOURTH-BOT-TOKEN
# BOT_LABEL_4=Ops Bot
# BOT_TOKEN_5=123456:ABC-YOUR-FIFTH-BOT-TOKEN
# BOT_LABEL_5=CEO Bot

# MTProto credentials (required). Get from https://my.telegram.org → API development tools.
API_ID=
API_HASH=

PANEL_PASSWORD=change-me
SESSION_SECRET=change-me-to-random-long-string
PORT=3000
# Optional: point to a custom built frontend directory (relative to backend/).
# If unset, backend serves the minimal panel from backend/public/
# FRONTEND_DIST=../frontend/dist
